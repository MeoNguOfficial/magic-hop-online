{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/dev/crates/tauri-cli/schema.json",
  "productName": "Cyber Beat Hopper",
  "version": "1.0.7",
  "identifier": "com.meotn.cyberbeathopper",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cyber Beat Hopper - MeoTN Gaming",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../icons/icon-128x128.png",
      "../icons/icon-512x512.png",
      "../favicon.ico"
    ],
    "category": "Game",
    "shortDescription": "3D Cyberpunk Rhythm Game",
    "longDescription": "Cyber Beat Hopper is a 3D cyberpunk rhythm game running on Three.js WebGL.",
    "macOS": {
      "category": "public.app-category.music-games",
      "minimumSystemVersion": "10.15"
    }
  }
}
